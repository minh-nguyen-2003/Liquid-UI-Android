<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nền kính mờ + vệt sáng chạy theo mép — xem LiquidLayout -->
    <declare-styleable name="LiquidLayout">
        <attr name="lgv_backgroundColor" format="color" />
        <attr name="lgv_cornerRadius" format="dimension" />
        <!-- true: bán kính = nửa cạnh ngắn ⇒ view vuông ra hình tròn, view ngang ra pill -->
        <attr name="lgv_pill" format="boolean" />
        <attr name="lgv_highlightColor" format="color" />
        <attr name="lgv_highlightWidth" format="dimension" />
        <attr name="lgv_highlightAlpha" format="float" />
        <!-- false: tắt hẳn viền sáng lẫn quầng sáng; mặc định true -->
        <attr name="lgv_highlight" format="boolean" />
        <attr name="lgv_glow" format="boolean" />
        <attr name="lgv_clipContent" format="boolean" />
        <!-- Giá trị enum phải khớp hằng số trong LiquidGlassOrientation -->
        <attr name="lgv_highlightOrientation">
            <enum name="left_right" value="0" />
            <enum name="top_bottom" value="1" />
            <enum name="top_left_bottom_right" value="2" />
            <enum name="top_right_bottom_left" value="3" />
        </attr>
        <!-- Chế độ nền. Giá trị enum phải khớp hằng số trong LiquidGlassMode -->
        <attr name="lgv_mode">
            <!-- Chỉ phủ lớp màu + vệt sáng, không đụng tới nội dung phía sau (mặc định) -->
            <enum name="tint" value="0" />
            <!-- Thấu kính thật: nội dung phía sau nét nguyên ở giữa, bị bẻ cong ở vành mép -->
            <enum name="lens" value="1" />
            <!-- Kính mờ: làm mờ thật mọi thứ phía sau (giao diện + video) -->
            <enum name="blur" value="2" />
        </attr>
        <!-- (blur) Độ mờ của nền: độ lệch chuẩn của mờ Gauss (như blur() của CSS); mặc định 4dp -->
        <attr name="lgv_blurRadius" format="dimension" />
        <!-- (blur) Làm mờ những gì phía sau. Giá trị enum phải khớp hằng số trong GlassBackdropMode -->
        <attr name="lgv_backdrop">
            <!-- Mọi thứ đang hiện: giao diện thường lẫn video (mặc định) -->
            <enum name="all" value="0" />
            <!-- Chỉ video (TextureView) và ảnh phủ ít nhất nửa cửa sổ; nhẹ hơn -->
            <enum name="media" value="1" />
        </attr>
        <!-- (blur) Bẻ cong nền mờ ở mép: mép với tới vành nền ngoài view bằng chừng này lần nửa cạnh ngắn; mặc định 0 = tắt -->
        <attr name="lgv_edgeRefraction" format="float" />
        <!-- (blur) Độ đậm màu của nền mờ; mặc định 1 = giữ nguyên -->
        <attr name="lgv_blurSaturation" format="float" />
        <!-- View bấm được thì lún còn chừng này khi giữ; mặc định 1 = không lún -->
        <attr name="lgv_pressScale" format="float" />
        <!-- (lens) Bề rộng vành mép vát tròn, phần bị bẻ cong; mặc định 12dp -->
        <attr name="lgv_bevelWidth" format="dimension" />
        <!-- (lens) Độ bẻ cong: sát mép hiện phần nền nằm sâu vào trong chừng này lần bề rộng vành; 0 = không bẻ; mặc định 1 -->
        <attr name="lgv_refraction" format="float" />
        <!-- (lens) Phóng to nội dung phía sau quanh tâm như kính lúp; mặc định 1 = không phóng -->
        <attr name="lgv_lensZoom" format="float" />
        <!-- (lens) Độ mờ của nội dung nhìn qua kính (độ lệch chuẩn của mờ Gauss); mặc định 0 = nét -->
        <attr name="lgv_lensBlur" format="dimension" />
    </declare-styleable>

    <!-- Kính chỉ làm mờ nền phía sau (kể cả video), không có viền sáng kiểu liquid — xem GlassLayout -->
    <declare-styleable name="GlassLayout">
        <!-- Màu phủ trên nền đã làm mờ, kèm độ mờ; mặc định #171717 30 % -->
        <attr name="gl_color" format="color" />
        <!-- Bo góc; không khai = bo tròn hai đầu (hình tròn khi vuông) -->
        <attr name="gl_cornerRadius" format="dimension" />
        <!-- Làm mờ nội dung phía sau; mặc định true -->
        <attr name="gl_blur" format="boolean" />
        <!-- Độ mờ của nền: độ lệch chuẩn của mờ Gauss (như blur() của CSS), càng lớn càng nhoè; mặc định 4dp -->
        <attr name="gl_blurRadius" format="dimension" />
        <!-- Làm mờ những gì phía sau. Giá trị enum phải khớp hằng số trong GlassBackdropMode -->
        <attr name="gl_backdrop">
            <!-- Mọi thứ đang hiện: giao diện thường lẫn video (mặc định) -->
            <enum name="all" value="0" />
            <!-- Chỉ video (TextureView) và ảnh phủ ít nhất nửa cửa sổ; nhẹ hơn -->
            <enum name="media" value="1" />
        </attr>
        <!-- Chế độ nền. Giá trị enum phải khớp hằng số trong GlassMode -->
        <attr name="gl_mode">
            <!-- Làm mờ nền phía sau (mặc định) -->
            <enum name="blur" value="0" />
            <!-- Thấu kính thật như lgv_mode="lens" của LiquidLayout: không mờ, nền nét ở giữa, bẻ cong ở vành mép -->
            <enum name="lens" value="1" />
        </attr>
        <!-- (lens) Bề rộng vành mép vát tròn, phần bị bẻ cong; mặc định 12dp -->
        <attr name="gl_bevelWidth" format="dimension" />
        <!-- (lens) Độ bẻ cong: sát mép hiện phần nền nằm sâu vào trong chừng này lần bề rộng vành; 0 = không bẻ; mặc định 1 -->
        <attr name="gl_lensRefraction" format="float" />
        <!-- (lens) Phóng to nội dung phía sau quanh tâm như kính lúp; mặc định 1 = không phóng -->
        <attr name="gl_lensZoom" format="float" />
        <!-- (lens) Độ mờ của nội dung nhìn qua kính (độ lệch chuẩn của mờ Gauss); mặc định 0 = nét -->
        <attr name="gl_lensBlur" format="dimension" />
    </declare-styleable>

    <!-- Kính làm mờ + bẻ cong nền ở mép (kể cả video), không có viền sáng kiểu liquid — xem GlassLensLayout. Dùng thêm được gl_* -->
    <declare-styleable name="GlassLensLayout">
        <!-- Độ bẻ cong nền ở mép: mép với tới vành nền ngoài view bằng chừng này lần nửa cạnh ngắn; 0 = tắt; mặc định 0.8 -->
        <attr name="gll_refraction" format="float" />
    </declare-styleable>

    <!-- Liquid glass đầy đủ: làm mờ + bẻ cong + viền sáng / ánh trượt (đặt trên video / ảnh) — xem LiquidGlassLayout -->
    <declare-styleable name="LiquidGlassLayout">
        <!-- Màu nền kính kèm độ mờ; mặc định #171717 30 % -->
        <attr name="lgl_color" format="color" />
        <!-- Bo góc; không khai = bo tròn hai đầu (hình tròn khi vuông) -->
        <attr name="lgl_cornerRadius" format="dimension" />
        <!-- Độ dày viền sáng; mặc định 1dp -->
        <attr name="lgl_rimWidth" format="dimension" />
        <attr name="lgl_rimColor" format="color" />
        <!-- Độ sáng lớn nhất của viền ở phía nguồn sáng, 0..1; mặc định 0.55 -->
        <attr name="lgl_rimAlpha" format="float" />
        <!-- Hướng nguồn sáng, độ: 0 = phải, tăng theo chiều kim đồng hồ; mặc định 225 (trên trái) -->
        <attr name="lgl_lightAngle" format="float" />
        <!-- Độ sáng ánh trượt trên mặt kính, 0..1 (0 = tắt); mặc định 0.16 -->
        <attr name="lgl_sheenAlpha" format="float" />
        <!-- Tỉ lệ thu nhỏ khi giữ (1 = không lún); chỉ có tác dụng khi view clickable; mặc định 0.92 -->
        <attr name="lgl_pressScale" format="float" />
        <!-- Làm mờ nội dung phía sau; mặc định true -->
        <attr name="lgl_blur" format="boolean" />
        <!-- Độ bẻ cong nền mờ ở mép kính (khúc xạ): mép với tới vành nền ngoài nút bằng chừng này lần bán kính; 0 = tắt; mặc định 0.8 -->
        <attr name="lgl_refraction" format="float" />
    </declare-styleable>
</resources>
