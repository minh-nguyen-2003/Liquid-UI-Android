<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/glassRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Header: 2 nút tròn + tiêu đề. lgv_pill tự lấy nửa cạnh ngắn nên không cần biết size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:lgv_pill="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_menu" />
            </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_title"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_subtitle"
                    android:textColor="@color/white_50"
                    android:textSize="12sp" />
            </LinearLayout>

            <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:lgv_pill="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_bell" />
            </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>
        </LinearLayout>

        <!-- ================= pill ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_pill" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:lgv_pill="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_search" />
            </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>

            <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                app:lgv_highlightOrientation="top_bottom"
                app:lgv_pill="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_star" />
            </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>

            <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                app:lgv_backgroundColor="#40FFFFFF"
                app:lgv_pill="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_chat" />
            </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>
        </LinearLayout>

        <!-- Pill dẹt: vẫn 1 attr lgv_pill, không cần đo trước chiều cao -->
        <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            app:lgv_pill="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/search_hint"
                    android:textColor="@color/white_50"
                    android:textSize="14sp" />
            </LinearLayout>
        </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>

        <!-- ================= lens ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_lens" />

        <!-- Chữ nằm dưới, hai tấm kính lens đè lên: giữa kính chữ nét nguyên, vành mép 12dp bị bẻ cong. Kính tròn bên phải phóng 1,4 lần
             như kính lúp. lgv_backgroundColor trong suốt để thấy rõ phần khúc xạ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/lens_text"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:maxLines="1"
                    android:text="@string/lens_sample"
                    android:textColor="@android:color/white"
                    android:textSize="34sp" />
            </LinearLayout>

            <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
                android:layout_width="150dp"
                android:layout_height="64dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                app:lgv_backgroundColor="@android:color/transparent"
                app:lgv_mode="lens"
                app:lgv_pill="true" />

            <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="24dp"
                app:lgv_backgroundColor="@android:color/transparent"
                app:lgv_bevelWidth="16dp"
                app:lgv_lensZoom="1.4"
                app:lgv_mode="lens"
                app:lgv_pill="true"
                app:lgv_refraction="1.3" />
        </FrameLayout>

        <!-- ================= card ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_card" />

        <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:lgv_cornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_title"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/card_desc"
                    android:textColor="@color/white_70"
                    android:textSize="13sp" />

                <!-- Kính lồng trong kính: nút bên trong chỉ là một LiquidLayout nữa -->
                <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
                    android:id="@+id/btnOrientation"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:lgv_backgroundColor="#33FFFFFF"
                    app:lgv_pill="true">

                    <TextView
                        android:id="@+id/tvOrientation"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:text="Nguồn sáng: top_left" />
                </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>
            </LinearLayout>
        </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>

        <!-- ================= list item ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_list" />

        <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:lgv_cornerRadius="18dp"
            app:lgv_glow="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/item_1"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>

        <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            app:lgv_cornerRadius="18dp"
            app:lgv_glow="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/item_2"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>

        <!-- ================= playground ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_playground" />

        <vn.minh_nguyen.vkey.liquid.ui.LiquidLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:lgv_cornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_alpha"
                    android:textColor="@color/white_70"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekAlpha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="55" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_glow"
                        android:textColor="@color/white_70"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchGlow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>
        </vn.minh_nguyen.vkey.liquid.ui.LiquidLayout>
    </LinearLayout>
</ScrollView>
